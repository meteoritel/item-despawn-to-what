{
  "name": "condition-scales",
  "description": "1x/2x/3x 三档 GUI 缩放各打开一次条件编辑画布（3x 用 1920x1080 窗口保持逻辑宽 640）：标题文案来自语言文件、模态完整落在窗口内，截图留证。",
  "window": {
    "width": 1280,
    "height": 720,
    "scale": 2
  },
  "settle": {
    "timeout_ms": 2500
  },
  "steps": [
    {
      "action": {
        "kind": "resize",
        "width": 1280,
        "height": 720,
        "scale": 1
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tab.trigger"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tree.button.open"
        }
      }
    },
    {
      "assert": {
        "name": "1x 条件画布标题来自语言文件",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "assert": {
        "name": "1x 条件画布模态完整落在窗口内",
        "kind": "geometry_inside",
        "selector": {
          "kind": "MODAL"
        }
      }
    },
    {
      "shot": "40-condition-1x.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.back"
        }
      }
    },
    {
      "assert": {
        "name": "1x Back 关闭条件编辑画布",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "action": {
        "kind": "resize",
        "width": 1280,
        "height": 720,
        "scale": 2
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tab.trigger"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tree.button.open"
        }
      }
    },
    {
      "assert": {
        "name": "2x 条件画布标题来自语言文件",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "assert": {
        "name": "2x 条件画布模态完整落在窗口内",
        "kind": "geometry_inside",
        "selector": {
          "kind": "MODAL"
        }
      }
    },
    {
      "shot": "40-condition-2x.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.back"
        }
      }
    },
    {
      "assert": {
        "name": "2x Back 关闭条件编辑画布",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "action": {
        "kind": "resize",
        "width": 1920,
        "height": 1080,
        "scale": 3
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tab.trigger"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tree.button.open"
        }
      }
    },
    {
      "assert": {
        "name": "3x 条件画布标题来自语言文件",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "assert": {
        "name": "3x 条件画布模态完整落在窗口内",
        "kind": "geometry_inside",
        "selector": {
          "kind": "MODAL"
        }
      }
    },
    {
      "shot": "40-condition-3x.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.back"
        }
      }
    },
    {
      "assert": {
        "name": "3x Back 关闭条件编辑画布",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "dump": "40-condition-scales.json",
      "query": {
        "source": "layout"
      }
    }
  ],
  "start": {
    "kind": "editor",
    "new_rule": true
  }
}
