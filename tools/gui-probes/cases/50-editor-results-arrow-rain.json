{
  "name": "editor-results-arrow-rain",
  "description": "从新草稿通过真实动作选择器建立箭雨，验证 Pickup 轮询及药水卡片增删与换引用。",
  "start": {
    "kind": "editor",
    "new_rule": true
  },
  "window": {
    "width": 1600,
    "height": 1000,
    "scale": 2
  },
  "steps": [
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tab.results"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.effect_add"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.effect.arrow_rain"
        }
      }
    },
    {
      "assert": {
        "name": "gui.itemdespawntowhat.edit.field.arrow_rain.pickup",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.field.arrow_rain.pickup"
        }
      }
    },
    {
      "assert": {
        "name": "Pickup 单值",
        "kind": "text_count",
        "selector": {
          "kind": "CONTROL",
          "lang_any": [
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.allowed",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.creative_only",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.disallowed"
          ]
        },
        "expected": 1
      }
    },
    {
      "capture": "pickup",
      "query": {
        "source": "text",
        "selector": {
          "kind": "CONTROL",
          "lang_any": [
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.allowed",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.creative_only",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.disallowed"
          ]
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang_any": [
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.allowed",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.creative_only",
            "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.disallowed"
          ]
        }
      }
    },
    {
      "wait_for": {
        "name": "Pickup 切换后变化",
        "kind": "value_changed",
        "capture": "pickup",
        "query": {
          "source": "text",
          "selector": {
            "kind": "CONTROL",
            "lang_any": [
              "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.allowed",
              "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.creative_only",
              "gui.itemdespawntowhat.edit.enum.arrow_rain_pickup.disallowed"
            ]
          }
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.list.add",
          "within": {
            "lang": "gui.itemdespawntowhat.edit.field.arrow_rain.potion_effects"
          }
        }
      }
    },
    {
      "assert": {
        "name": "目录打开",
        "kind": "text_count",
        "selector": {
          "kind": "MODAL"
        },
        "expected": 1
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "ROW",
          "text": "Absorption"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        }
      }
    },
    {
      "assert": {
        "name": "新增药水卡片",
        "kind": "text_count",
        "selector": {
          "kind": "CONTROL",
          "text": "Absorption"
        },
        "expected": 1
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "text": "Absorption"
        }
      }
    },
    {
      "assert": {
        "name": "单条换引用打开目录",
        "kind": "text_count",
        "selector": {
          "kind": "MODAL"
        },
        "expected": 1
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        }
      }
    },
    {
      "assert": {
        "name": "换引用后单卡",
        "kind": "text_count",
        "selector": {
          "kind": "CONTROL",
          "text": "Absorption"
        },
        "expected": 1
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.list.remove"
        }
      }
    },
    {
      "assert": {
        "name": "删除药水卡片",
        "kind": "text_absent",
        "selector": {
          "kind": "CONTROL",
          "text": "Absorption"
        }
      }
    },
    {
      "shot": "50-arrow-rain.png"
    },
    {
      "dump": "50-arrow-rain.json",
      "query": {
        "source": "layout"
      }
    }
  ]
}
