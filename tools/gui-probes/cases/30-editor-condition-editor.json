{
  "name": "editor-condition-editor",
  "description": "点 Trigger 页签 → 点 Edit condition tree 进入条件编辑画布 → 点空态占位打开类型选择器 → 选 Outdoor 落一个条件叶 → 点模态 Back 关闭；每步截图留证。",
  "window": {
    "width": 1280,
    "height": 720,
    "scale": 2
  },
  "settle": {
    "timeout_ms": 2000
  },
  "steps": [
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tab.trigger"
        }
      }
    },
    {
      "assert": {
        "name": "Trigger 页有打开条件树的按钮",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.button.open"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tree.button.open"
        }
      }
    },
    {
      "assert": {
        "name": "条件编辑画布标题来自语言文件",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "assert": {
        "name": "空画布显示添加条件占位",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.add_placeholder"
        }
      }
    },
    {
      "shot": "30-condition-canvas-empty.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.tree.add_placeholder"
        }
      }
    },
    {
      "assert": {
        "name": "类型选择器标题来自语言文件",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.picker.title"
        }
      }
    },
    {
      "assert": {
        "name": "选择器列出 Outdoor 类型",
        "kind": "text_present",
        "selector": {
          "lang": "condition.itemdespawntowhat.type.outdoor"
        }
      }
    },
    {
      "shot": "30-condition-type-picker.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "condition.itemdespawntowhat.type.outdoor"
        }
      }
    },
    {
      "assert": {
        "name": "选完类型后选择器关闭",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.picker.title"
        }
      }
    },
    {
      "assert": {
        "name": "画布出现 Outdoor 条件叶",
        "kind": "text_present",
        "selector": {
          "lang": "condition.itemdespawntowhat.type.outdoor"
        }
      }
    },
    {
      "shot": "30-condition-canvas-leaf.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.back"
        }
      }
    },
    {
      "assert": {
        "name": "Back 关闭条件编辑画布",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tree.title"
        }
      }
    },
    {
      "dump": "30-editor-condition-editor.json",
      "query": {
        "source": "layout"
      }
    }
  ],
  "start": {
    "kind": "editor",
    "new_rule": true
  }
}
