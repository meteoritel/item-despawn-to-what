{
  "name": "editor-new-rule",
  "description": "真实点击 New rule 打开命名弹窗；点内容区聚焦后先用退格清空输入，断言确认按钮变灰（键盘输入确实落到真实控件、校验随之联动），再输入唯一名字、断言确认按钮恢复，点 Confirm 进入编辑页；页签按语言文件真值核对，截图留证。",
  "window": {
    "width": 1280,
    "height": 720,
    "scale": 2
  },
  "settle": {
    "timeout_ms": 2000
  },
  "steps": [
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.new"
        }
      }
    },
    {
      "assert": {
        "name": "出现新建规则弹窗标题",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.prompt.new_title"
        }
      }
    },
    {
      "assert": {
        "name": "弹窗有确认按钮",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        }
      }
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "TEXT_INPUT"
        }
      }
    },
    {
      "action": {
        "kind": "clear"
      }
    },
    {
      "assert": {
        "name": "名字清空后确认按钮变灰",
        "kind": "node_enabled",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        },
        "expected": false
      }
    },
    {
      "action": {
        "kind": "type",
        "unique_text": true
      }
    },
    {
      "assert": {
        "name": "输入合法名字后确认按钮恢复",
        "kind": "node_enabled",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        },
        "expected": true
      }
    },
    {
      "shot": "20-new-rule-prompt.png"
    },
    {
      "action": {
        "kind": "click",
        "selector": {
          "kind": "CONTROL",
          "lang": "gui.itemdespawntowhat.edit.button.confirm"
        }
      }
    },
    {
      "assert": {
        "name": "编辑页有 Basic 页签",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tab.info"
        }
      }
    },
    {
      "assert": {
        "name": "编辑页有 Trigger 页签",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tab.trigger"
        }
      }
    },
    {
      "assert": {
        "name": "编辑页有 Results 页签",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.tab.results"
        }
      }
    },
    {
      "assert": {
        "name": "命名弹窗已关闭",
        "kind": "text_absent",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.prompt.new_title"
        }
      }
    },
    {
      "assert": {
        "name": "编辑页标题来自语言文件",
        "kind": "value_equals",
        "query": {
          "source": "screen_title"
        },
        "expected_lang": "gui.itemdespawntowhat.edit.title"
      }
    },
    {
      "shot": "20-editor-edit-page.png"
    },
    {
      "dump": "20-editor-edit-page.json",
      "query": {
        "source": "layout"
      }
    }
  ],
  "start": {
    "kind": "editor"
  }
}
