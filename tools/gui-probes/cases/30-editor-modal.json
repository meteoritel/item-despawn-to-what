{
  "name": "editor-new-rule-modal",
  "description": "点真实按钮弹出新建规则模态，确认模态层进入布局快照且带真实的确认/取消文案；取消后模态退出。",
  "window": {
    "width": 640,
    "height": 480,
    "scale": 2
  },
  "settle_ms": 700,
  "steps": [
    {
      "check": {
        "name": "初始没有模态层",
        "expr": "__gp.flat(__gp.layout()).filter(function(n){return (n.kind==='MODAL');}).length",
        "expected": 0
      }
    },
    {
      "do": "__gp.clickWidgetAny(['New rule', '新建规则'])"
    },
    {
      "wait_ms": 900
    },
    {
      "check": {
        "name": "点击后出现模态层",
        "expr": "__gp.flat(__gp.layout()).filter(function(n){return (n.kind==='MODAL');}).length > 0",
        "expected": true
      }
    },
    {
      "check": {
        "name": "模态文案包含确认按钮（英文语言文件真值）",
        "expr": "__gp.textNodes().join(' ')",
        "expected_lang": "gui.itemdespawntowhat.edit.button.confirm",
        "lang": "en_us",
        "contains": true
      }
    },
    {
      "check": {
        "name": "模态文案包含取消按钮（英文语言文件真值）",
        "expr": "__gp.textNodes().join(' ')",
        "expected_lang": "gui.itemdespawntowhat.edit.button.cancel",
        "lang": "en_us",
        "contains": true
      }
    },
    {
      "shot": "30-new-rule-modal.png",
      "rects": "__gp.rects(['MODAL','CONTROL'])"
    },
    {
      "do": "__gp.clickWidgetAny(['Cancel', '取消'])"
    },
    {
      "wait_ms": 900
    },
    {
      "check": {
        "name": "取消后模态层退出",
        "expr": "__gp.flat(__gp.layout()).filter(function(n){return (n.kind==='MODAL');}).length",
        "expected": 0
      }
    },
    {
      "shot": "30-after-cancel.png",
      "rects": "__gp.rects(['CONTROL'])"
    }
  ]
}
