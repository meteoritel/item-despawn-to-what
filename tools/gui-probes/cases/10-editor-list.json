{
  "name": "editor-list",
  "description": "回到编辑器列表页：标题、新建按钮与搜索占位按语言文件真值核对，截图留证。",
  "window": {
    "width": 1280,
    "height": 720,
    "scale": 2
  },
  "settle": {
    "timeout_ms": 2000
  },
  "steps": [
    {
      "assert": {
        "name": "列表页标题来自语言文件",
        "kind": "value_equals",
        "query": {
          "source": "screen_title"
        },
        "expected_lang": "gui.itemdespawntowhat.edit.title"
      }
    },
    {
      "assert": {
        "name": "列表页有新建规则按钮",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.button.new"
        }
      }
    },
    {
      "assert": {
        "name": "列表页有搜索框占位",
        "kind": "text_present",
        "selector": {
          "lang": "gui.itemdespawntowhat.edit.list.search"
        }
      }
    },
    {
      "shot": "10-editor-list.png"
    },
    {
      "dump": "10-editor-list.json",
      "query": {
        "source": "layout"
      }
    }
  ],
  "start": {
    "kind": "editor"
  }
}
