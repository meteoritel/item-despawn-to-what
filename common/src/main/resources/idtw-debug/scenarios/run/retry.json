{
  "schema_version": 1,
  "inputs": {
    "sources": 1,
    "stack_size": 1,
    "catalyst_count": 0,
    "source_item": "minecraft:paper",
    "catalyst_item": "minecraft:emerald"
  },
  "seconds": 12,
  "setup": "none",
  "actions": [
    {
      "type": "move_source",
      "after_ticks": 100,
      "after_event": "RETRY",
      "offset_y": 3
    }
  ],
  "expected": {
    "metrics": {
      "conversions": "$sources",
      "remaining_source_items": 0,
      "groups": "$source_items",
      "consumed_sources": "$source_items",
      "returned": 0,
      "pending_delivery": 0,
      "settlements_completed": "$sources",
      "chance_skipped": 0,
      "live_returned_source_items": 0,
      "protected_returned_source_items": 0,
      "remaining_catalyst": 0,
      "events/CONDITION_FALSE": {
        "min": 1
      },
      "events/RETRY": {
        "min": 1
      },
      "action_count": 1
    },
    "outputs": {
      "minecraft:prismarine_shard": "$source_items"
    },
    "candidates": {
      "default": "$sources"
    }
  },
  "rules": [
    {
      "id": "itemdespawntowhat:debug/retry",
      "enabled": true,
      "priority": 0,
      "trigger_after_seconds": 2,
      "source": {
        "items": [
          "minecraft:paper"
        ],
        "exclude": []
      },
      "effects": [
        {
          "type": "itemdespawntowhat:spawn_entity",
          "item": "minecraft:prismarine_shard",
          "count": 1,
          "delay_ticks": 0,
          "chance": 1,
          "variant": "item"
        }
      ],
      "conditions": {
        "op": "leaf",
        "condition": {
          "type": "itemdespawntowhat:y_level",
          "min": "$origin_y_plus_3"
        }
      }
    }
  ]
}
