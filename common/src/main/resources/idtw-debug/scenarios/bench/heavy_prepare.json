{
  "schema_version": 1,
  "inputs": {
    "sources": 1000,
    "stack_size": 16,
    "catalyst_count": 0,
    "source_item": "minecraft:paper",
    "catalyst_item": "minecraft:emerald"
  },
  "seconds": 60,
  "setup": "none",
  "actions": [],
  "expected": {
    "metrics": {
      "conversions": "$sources",
      "remaining_source_items": 0,
      "groups": "$source_items",
      "consumed_sources": "$source_items",
      "returned": 0,
      "pending_delivery": 0,
      "settlements_completed": "$sources",
      "chance_skipped": 0,
      "live_returned_source_items": 0,
      "protected_returned_source_items": 0,
      "remaining_catalyst": 0,
      "prepared_groups": "$source_items",
      "budget_ticks_exhausted_by_work_units": {
        "min": 1
      },
      "budget_peak_work_units_in_tick": {
        "max": 512
      },
      "settlement_ledger_commits": {
        "min": "$sources"
      },
      "settlement_ledger_deferred_mutations": {
        "min": "$sources"
      }
    },
    "outputs": {
      "minecraft:prismarine_shard": 0
    },
    "candidates": {
      "default": "$sources"
    }
  },
  "rules": [
    {
      "id": "itemdespawntowhat:debug/bench/heavy_prepare",
      "enabled": true,
      "priority": 0,
      "trigger_after_seconds": 10,
      "source": {
        "items": [
          "minecraft:paper"
        ],
        "exclude": []
      },
      "effects": [
        {
          "type": "itemdespawntowhat:loot_table",
          "loot_table": "minecraft:chests/simple_dungeon",
          "luck": 0,
          "delay_ticks": 0,
          "chance": 1,
          "conditions": {
            "op": "leaf",
            "condition": {
              "type": "itemdespawntowhat:y_level",
              "min": "$origin_y_plus_3"
            }
          }
        },
        {
          "type": "itemdespawntowhat:spawn_entity",
          "item": "minecraft:prismarine_shard",
          "count": 1,
          "delay_ticks": 0,
          "chance": 1,
          "variant": "item",
          "conditions": {
            "op": "leaf",
            "condition": {
              "type": "itemdespawntowhat:y_level",
              "min": "$origin_y_plus_3"
            }
          }
        }
      ]
    }
  ]
}
